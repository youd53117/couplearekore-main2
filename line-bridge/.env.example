# LINE Messaging API Credentials (LINE Developers Console)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 初回起動時は空欄のままにしてください（確認モードが起動し、送信元のuserIdを返信・表示します）
ALLOWED_LINE_USER_ID=

# Webhook Server Settings
PORT=8787
HOST=127.0.0.1

# 4部署ワークフローを実行するCLIコマンド（{prompt} に指示文、{workdir} にリポジトリパスが入ります）
# 例: agy run --cwd {workdir} "{prompt}"
AGENT_COMMAND=
AGENT_TIMEOUT_SECONDS=1800

# 完了後に自動で git commit & push する場合は true
AUTO_GIT_PUSH=false
